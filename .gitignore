# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Secrets. `*.local` above already catches `.env.local`, which is the one this
# repo actually uses — but ONLY that one. A file named `.env`, `.env.production`
# or `.env.staging` would sail straight past it, and this repository is PUBLIC.
# Anything committed here is public the moment it is pushed and stays in the
# history afterwards, so the rule is written to cover the shapes nobody has
# created yet rather than the one that exists.
.env
.env.*
!.env.example

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Playwright output — traces and screenshots are per-run diagnostics, uploaded
# as a CI artifact on failure rather than committed.
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# Planning docs (kept local, not shipped)
Jungle - Delta & Backlog Breakdown.md
Jungle - Work Item Tracker.xlsx

# Office lock files. Word writes `~$name.docx` beside a document while it is
# open, so one appeared at `src/~$ngle_tech_spec.docx` mid-session — inside the
# SOURCE tree, untracked, and two characters away from being swept into a
# `git add -A`. It is 162 bytes of the author's username and nothing else.
~$*
